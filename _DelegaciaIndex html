<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Delegacia</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<style>
    * {
        border: 1px solid #ff5f02;
    }
</style>

<body>
    <section class="container">
        <form id="topContainer">

            <div class="row">
                <div class="col">
                    <label for="termoBusca" class="form-label">
                        Delegacia:
                    </label>

                    <select class="form-select" id="termoBusca">
                        <option>Selecionar Delegacia</option>
                        <option>Origem 1</option>
                        <option>Origem 2</option>
                        <option>Origem 3</option>
                        <option>Origem 4</option>
                    </select>
                </div>
                <div class="col align-self-end">
                    <button type="button" class="btn btn-primary">
                        Pesquisar
                    </button>
                </div>
            </div>

        <section class="container">
            <div >
                <div>
                    <h1>Delegado</h1>
                </div>
                <div class="row">
                     <div class="col-2">Nome</div>
                    <div class="col-2">Início</div>
                    <div class="col-2">Fim</div>
                    <div class="col-2">Condição</div>
                    <div class="col-2">Editar/Novo</div>
                    <div class="col-2">Historico</div>
                </div>
            </div>
        </section>


        <section class="container">
            <div >
                <div>
                    <h1>Assistente de Delegado</h1>
                </div>
                <div class="row">
                     <div class="col-2">Nome</div>
                    <div class="col-2">Início</div>
                    <div class="col-2">Fim</div>
                    <div class="col-2">Editar/Novo</div>
                    <div class="col-2">Historico</div>
                </div>
            </div>
        </section>

        <section class="container">
            <div >
                <div>
                    <h1>Técnico</h1>
                </div>
                <div class="row">
                     <div class="col-2">Nome</div>
                    <div class="col-2">Início</div>
                    <div class="col-2">Fim</div>
                    <div class="col-2">Editar/Novo</div>
                    <div class="col-2">Historico</div>
                </div>
            </div>
        </section>

        </form>

    </section>

</body>

</html>